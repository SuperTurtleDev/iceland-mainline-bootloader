## @file MainlineBootPkg.dec
#
#  Mainline Linux loader and application-mode UEFI boot manager.
#
#  SPDX-License-Identifier: BSD-3-Clause-Clear
##

[Defines]
  PACKAGE_NAME                   = MainlineBootPkg
  PACKAGE_GUID                  = F7B10A68-3190-482F-9919-331A98880605
  PACKAGE_VERSION               = 0.1

[Includes]
  Include
  Library/MbedTlsLib/Include
  Library/MbedTlsLib/mbedtls/include

[LibraryClasses]
  ##  ABL-style mainline Linux loader library (Image + DTB + initrd + cmdline).
  MainlineBootLib|Include/Library/MainlineBootLib.h
  SfbConfigStoreLib|Include/Library/SfbConfigStore.h
  SfbSecurityLib|Include/Library/SfbSecurity.h
  SfbMemFixupLib|Include/Library/SfbMemFixup.h
  FastbootLib|Include/FastbootLib/FastbootMain.h
  UefiVariableCommandsLib|Include/Library/UefiVariableCommandsLib.h
  MbedTlsLib|Library/MbedTlsLib/Include/mbedtls/mbedtls_config.h
  DiskIoDxeLib|Library/DiskIoDxeLib/DiskIo.h
  UnicodeCollationEngLib|Library/UnicodeCollationEngLib/UnicodeCollationEng.h

[Protocols]
  gSfbSecureBootProtocolGuid = { 0x2e7c4a19, 0xd5b0, 0x4c67, { 0x9a, 0x31, 0x86, 0x0f, 0x4d, 0x2b, 0x71, 0xe3 } }
  gEfiMemoryAttributeProtocolGuid = { 0xf4560cf6, 0x40ec, 0x4b4a, { 0xa1, 0x92, 0xbf, 0x1d, 0x57, 0xd0, 0xb1, 0x89 } }
