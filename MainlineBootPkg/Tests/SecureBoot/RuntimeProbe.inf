[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = RuntimeProbe
  FILE_GUID = E2230359-59B2-4842-AEB6-5EA27C61AD80
  MODULE_TYPE = UEFI_APPLICATION
  VERSION_STRING = 1.0
  ENTRY_POINT = RuntimeProbeEntry

[Sources]
  RuntimeProbe.c
  TestSupport.c
  SecureBootTest.h

[Packages]
