[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = CanoeFastbootLib
  FILE_GUID                      = 9588502a-5370-11e3-8631-d7c5951364c8
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = FastbootLib

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = ARM, AARCH64
#

[Sources]
  FastbootMain.c
  UsbDescriptors.c
  UsbSerial.c
  FastbootResponse.c
  FastbootCmds.c
  PartitionTableUpdate.c
  Board.c
  ThreadStack.c
  LinuxLoaderLib.c
  ShutdownServices.c

[BuildOptions]
  # Keep canoe's existing command set local to this library. Authorization is
  # enforced at runtime by BdsSecurityLib using standard UEFI db/dbx trust.
  GCC:*_*_*_CC_FLAGS = -DENABLE_UPDATE_PARTITIONS_CMDS -DENABLE_BOOT_CMD

[Packages]
  MainlineBootPkg/MainlineBootPkg.dec
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  TimerLib
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib
  # Storage authorization and independent standard EFI image verification.
  BdsSecurityLib
  UefiVariableCommandsLib

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiChipInfoProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiEraseBlockProtocolGuid
  gEfiKernelProtocolGuid
  gEfiMemCardInfoProtocolGuid
  gEfiNandPartiGuidProtocolGuid
  gEfiPartitionRecordGuid
  gEfiRamPartitionProtocolGuid
  gEfiResetReasonProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiUbiFlasherProtocolGuid
  gEfiUsbfnIoProtocolGuid
  gQcomPmicVersionProtocolGuid

[Guids]
  gBlockIoRefreshGuid
  gEfiEmmcUserPartitionGuid
  gEfiFileSystemInfoGuid
  gEfiNandUserPartitionGuid
  gEfiNvme0Guid
  gEfiPartitionTypeGuid
  gEfiUfsLU0Guid
  gEfiUfsLU1Guid
  gEfiUfsLU2Guid
  gEfiUfsLU3Guid
  gEfiUfsLU4Guid
  gEfiUfsLU5Guid
  gEfiUfsLU6Guid
  gEfiUfsLU7Guid
  gQcomTokenSpaceGuid

[FixedPcd]
  gQcomTokenSpaceGuid.EnableMultiThreadFlash
