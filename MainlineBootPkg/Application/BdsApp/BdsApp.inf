[Defines]
  INF_VERSION                    = 0x00010006
  BASE_NAME                      = BdsApp
  FILE_GUID                      = 9D4A0F24-3576-4FC2-8F7C-631EDDC4F89A
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BdsAppEntryPoint

[Sources]
